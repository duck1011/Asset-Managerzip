# ─────────────────────────────────────────────────────
# NorthSouth — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
# ─────────────────────────────────────────────────────

# Dev server (read by vite.config.ts; defaults: PORT=5173, BASE_PATH=/)
# PORT=5173
# BASE_PATH=/

# GitHub Pages (pnpm run build:pages from repo root)
# Project site: BASE_PATH=/Asset-Managerzip/
# Custom domain (public/CNAME or PAGES_CUSTOM_DOMAIN): BASE_PATH=/
# GITHUB_PAGES=true enables 404.html + .nojekyll in dist/public

# Vite exposes variables prefixed with VITE_ to the client bundle.
# Do NOT put secrets (API keys, tokens) in VITE_ variables.

# Base URL — set automatically by the Replit proxy; override locally if needed.
# VITE_BASE_URL=/

# Example: analytics or feature flags (all client-safe)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_FEATURE_CHATBOT=true
