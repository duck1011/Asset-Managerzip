# ─────────────────────────────────────────────────────
# NorthSouth — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
# ─────────────────────────────────────────────────────

# Vite exposes variables prefixed with VITE_ to the client bundle.
# Do NOT put secrets (API keys, tokens) in VITE_ variables.

# Base URL — set automatically by the Replit proxy; override locally if needed.
# VITE_BASE_URL=/

# Example: analytics or feature flags (all client-safe)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_FEATURE_CHATBOT=true
